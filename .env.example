# export — environment configuration
#
# Copy this file to `.env` and edit. The run.sh launcher loads .env
# automatically. Anything starting with `#` is a comment.

# === Required ===

# The single password gating all API endpoints. Sent as the X-Password
# header. Personal localhost stays 1234. For a public/trusted-group
# deploy use 32+ chars:  openssl rand -base64 24
EXPORT_PASSWORD=1234

# === Common — defaults are fine for personal use ===

# Where job working directories live. Auto-cleaned after 6 hours.
# EXPORT_DOWNLOADS=/tmp/export

# Network port for uvicorn. Set in run.sh, not here, if you need custom.
# PORT=8500

# Upload size caps in MB. Default 0 = UNLIMITED (correct for local use).
# Public / SECURITY.md Phase 2: 500 and 2000.
# EXPORT_MAX_UPLOAD_MB=500
# EXPORT_MAX_COMPRESS_MB=2000

# Mutating /api POSTs per IP per minute. Default 30. 0 disables.
# Unset under unittest (auto-off). Set a tiny value only to test 429s.
# EXPORT_RATE_LIMIT_PER_MINUTE=30

# === Cross-origin browser apps (e.g. cuttingboard's "Companion") ===
# Comma-separated exact origins allowed to call the API from their own page
# (CORS). Unset = no CORS headers: only this app's own UI on :8500 can call it.
# Allowed origins may send X-Password + Content-Type; a preflight asking for
# private-network access (a public https page reaching localhost:8500) gets
# Access-Control-Allow-Private-Network: true. Never use `*` with a password.
# EXPORT_CORS_ORIGIN=http://127.0.0.1:10100,https://cuttingboard.example

# === Public / Phase 2 (trusted-group deploy — see SECURITY.md) ===
# Personal localhost: leave these commented.
# EXPORT_DOWNLOAD_AUTODELETE=1
# EXPORT_CLEANUP_AGE_SECONDS=900
# EXPORT_CLEANUP_INTERVAL_SECONDS=60

# === Speech-to-text (Whisper) ===

# Default is large-v3-turbo — multilingual, much faster than large-v3.
# distil-large-v3 is English-only (despite the old README claim) so it is
# no longer the default. Other faster-whisper-compatible models:
#   tiny / base / small / medium (multilingual), *.en variants (English-only),
#   large-v3, distil-large-v3 (English-only, faster)
# EXPORT_WHISPER_MODEL=large-v3-turbo

# Override the model cache directory (defaults to ~/.cache/huggingface).
# Useful for shared / pre-downloaded models in deployment.
# EXPORT_WHISPER_MODEL_DIR=/var/cache/whisper

# Philippine dialect STT (Cebuano / Ilocano / Hiligaynon / Waray / Bikol).
# Not turbo+tl. First use converts rbcurzon/whisper-medium-ph to CT2 int8.
# EXPORT_WHISPER_PH_MODEL=rbcurzon/whisper-medium-ph
# EXPORT_WHISPER_PH_DIR=/var/cache/whisper-medium-ph-ct2

# === Speech-to-text via Groq (cloud, optional) ===
# When set, transcription routes to Groq's Whisper API (~200x realtime, paid
# at $0.04/h of audio for whisper-large-v3-turbo) instead of the local CPU
# Whisper. ~25x faster than local. Free tier exists with 8 h/day audio cap.
# Get a key at https://console.groq.com/keys
# EXPORT_GROQ_API_KEY=gsk_...

# Model. Default is whisper-large-v3-turbo (fastest, cheapest, comparable
# quality to large-v3 for most content). Other valid: whisper-large-v3.
# EXPORT_GROQ_MODEL=whisper-large-v3-turbo

# Audio is auto-chunked to stay under Groq's 25 MB upload cap. 20-min chunks
# at flac mono 16 kHz are ~10 MB — safe for both free and dev tier limits.
# EXPORT_GROQ_CHUNK_SECONDS=1200

# === Video shrink codec ===
# Default is libx264 (h.264) for universal playback compatibility. Set to "av1"
# to use SVT-AV1 (~20-30% smaller files at the same quality) — but AV1-in-MP4
# breaks on macOS Preview seeking, Discord embeds, old Safari, and many other
# consumer players. Only switch if your audience exclusively uses recent
# Chrome/Firefox/VLC/mpv.
# EXPORT_SHRINK_VIDEO_CODEC=x264

# Pin OCR / STT / TTS to one language (ISO 639-1: en, tl, es, zh, ja, …).
# Empty / unset = auto-detect from the file. The UI language dropdown sends
# the same value per-job and wins over this for that job.
# EXPORT_LANGUAGE=tl

# Force a Tesseract `-l` string (e.g. eng+fil+spa). Overrides auto pack pick.
# EXPORT_OCR_LANG=eng+fil

# === Offline mode ===
# When 1, URL extraction and Groq are refused, and Whisper/rembg/demucs will
# not download models (local_files_only). Prefetch first: bash scripts/prefetch.sh
# EXPORT_OFFLINE=1

# Extra piper voices live here (filename prefix = language, e.g. es_ES-*.onnx).
# EXPORT_PIPER_VOICE_DIR=./voices

# === Translation (NLLB-200, 200 languages including Filipino) ===
# Per-job `translate_to` (ISO 639-1) from the UI wins. Process-wide default:
# EXPORT_TRANSLATE_TO=tl
# CTranslate2 snapshot (int8). First use downloads ~1.2 GB.
# EXPORT_NLLB_MODEL=entai2965/nllb-200-distilled-600M-ctranslate2
# EXPORT_NLLB_TOKENIZER=facebook/nllb-200-distilled-600M
# EXPORT_NLLB_MODEL_DIR=/var/cache/export/nllb-ct2

# === Text-to-speech ===

# Required on Linux for TTS (doc → audio). Path to a piper-tts .onnx voice.
# install-linux.sh downloads `voices/en_US-lessac-medium.onnx` for you.
# Not needed on macOS — we fall back to the built-in `say` command.
# EXPORT_PIPER_VOICE=/opt/export/voices/en_US-lessac-medium.onnx

# === URL extraction (yt-dlp + gallery-dl) ===

# Cookies for login-walled platforms. Pick ONE of these two methods:

# Method A (easiest) — name a logged-in browser, yt-dlp reads cookies live.
# Accepts: chrome, firefox, safari, edge, brave, opera, vivaldi.
# EXPORT_YTDLP_BROWSER=chrome

# Method B (headless / server) — Netscape-format cookies.txt path.
# Export from your browser using a "Get cookies.txt" extension.
# EXPORT_YTDLP_COOKIES=/path/to/cookies.txt

# Proxy for IP-blocked or geo-restricted platforms (TikTok, Rumble, etc.).
# Format: http://[user:pw@]host:port  or  socks5://host:port
# EXPORT_HTTP_PROXY=socks5://127.0.0.1:9050

# Browser impersonation mode for yt-dlp's curl-cffi transport.
# auto = use Chrome impersonation only for domains that usually need TLS
# fingerprint mimicry (TikTok / Instagram / Threads). Public YouTube stays on
# yt-dlp's default transport, which avoids curl-cffi cleanup crashes seen on
# Python 3.14. Set always to force it; never to disable it everywhere.
# EXPORT_YTDLP_IMPERSONATE=auto

# === Folder watch mode (Clop-style ambient compression) ===

# Optional — point at a folder; any image/video/PDF dropped in is auto-shrunk
# into <dir>/_optimized/. Useful for screenshot/screen-recording pipelines.
# EXPORT_WATCH_DIR=/Users/you/Desktop/Screenshots

# === Ephemeral-storage tuning ===
# Job dirs auto-delete after this many seconds (default 6 h).
# Bump higher if you transcribe long files and don't always download immediately.
# EXPORT_CLEANUP_AGE_SECONDS=21600
# How often the cleanup loop sweeps (default 15 min).
# EXPORT_CLEANUP_INTERVAL_SECONDS=900

# Stream-and-delete mode: as soon as the user finishes their download, the
# output file + job dir are nuked. Maximum-ephemeral. Trade-off: re-downloading
# the same file means re-processing. Recommended on public/VPS deploys.
# EXPORT_DOWNLOAD_AUTODELETE=1

# === Platform-specific (handled by run.sh, listed here for reference) ===

# macOS only — WeasyPrint needs to find libgobject from Homebrew.
# Set automatically by run.sh on Darwin; only override if Homebrew is at
# a non-standard path.
# DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib
